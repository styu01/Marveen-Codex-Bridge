+
+- Fiktív eredmény vagy elvégzett művelet állítása.
+- Indokolatlanul hosszú, ismétlődő válasz.
+- Más agent megszemélyesítése vagy a jóváhagyási rendszer megkerülése.
+`
+  return { claudeMd, soulMd }
+}
+
+export async function generateAgentIdentityFiles(
+  provider: 'claude' | 'codex',
+  name: string,
+  description: string,
+  model: string,
+  generators: AgentIdentityGenerators = {
+    claudeMd: generateClaudeMd,
+    soulMd: generateSoulMd,
+  },
+): Promise<AgentIdentityFiles> {
+  if (provider === 'codex') return buildCodexAgentIdentityFiles(name, description)
+  const [claudeMd, soulMd] = await Promise.all([
+    generators.claudeMd(name, description, model),
+    generators.soulMd(name, description),
+  ])
+  return { claudeMd, soulMd }
+}
