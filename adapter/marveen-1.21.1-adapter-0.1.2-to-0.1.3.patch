+import { describe, expect, it, vi } from 'vitest'
+import {
+  buildCodexAgentIdentityFiles,
+  generateAgentIdentityFiles,
+} from '../web/agent-scaffold.js'
+
+describe('Codex agent identity generation', () => {
+  it('builds deterministic provider-neutral identity and soul files', () => {
+    const result = buildCodexAgentIdentityFiles(
+      'codex-kutato',
+      'Piackutatást végez és ellenőrzött összefoglalót készít.',
+    )
+
+    expect(result.claudeMd).toContain('# codex-kutato')
+    expect(result.claudeMd).toContain('Piackutatást végez')
+    expect(result.claudeMd).toContain('bela_agent_message_send')
+    expect(result.claudeMd).not.toContain('tmux')
+    expect(result.soulMd).toContain('codex-kutato személyisége')
+  })
+
+  it('does not call either Claude generator for a Codex provider', async () => {
+    const claudeMd = vi.fn(async () => { throw new Error('Claude must not run') })
+    const soulMd = vi.fn(async () => { throw new Error('Claude must not run') })
+
+    const result = await generateAgentIdentityFiles(
+      'codex',
+      'codex-kutato',
+      'Kutatási feladatokat végez.',
+      'gpt-5.6-terra',
+      { claudeMd, soulMd },
+    )
+
+    expect(result.claudeMd).toContain('Kutatási feladatokat végez.')
+    expect(claudeMd).not.toHaveBeenCalled()
+    expect(soulMd).not.toHaveBeenCalled()
+  })
+
+  it('keeps the existing generators for Claude agents', async () => {
+    const claudeMd = vi.fn(async () => 'generated CLAUDE.md')
+    const soulMd = vi.fn(async () => 'generated SOUL.md')
+
+    await expect(generateAgentIdentityFiles(
+      'claude',
+      'claude-kutato',
+      'Kutat.',
+      'claude-opus',
+      { claudeMd, soulMd },
+    )).resolves.toEqual({
+      claudeMd: 'generated CLAUDE.md',
+      soulMd: 'generated SOUL.md',
+    })
+    expect(claudeMd).toHaveBeenCalledOnce()
+    expect(soulMd).toHaveBeenCalledOnce()
+  })
+})
