+export function hasEquivalentAgentReply(
+  fromAgent: string,
+  toAgent: string,
+  content: string,
+  notBefore: number,
+): boolean {
+  const row = getDb().prepare(`
+    SELECT id
+    FROM agent_messages
+    WHERE from_agent = ?
+      AND to_agent = ?
+      AND content = ?
+      AND created_at >= ?
+    ORDER BY id DESC
+    LIMIT 1
+  `).get(fromAgent, toAgent, content, notBefore)
+  return Boolean(row)
+}
