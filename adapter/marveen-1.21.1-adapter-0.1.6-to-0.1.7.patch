@@ -0,0 +1,54 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const dbGet = vi.hoisted(() => vi.fn())
+
+vi.mock('../db.js', () => ({
+  createAgentMessage: vi.fn(),
+  getAgentMessage: vi.fn(),
+  getDb: () => ({
+    prepare: vi.fn(() => ({ get: dbGet })),
+  }),
+  markMessageDone: vi.fn(),
+  markMessageFailed: vi.fn(),
+}))
+
+import {
+  CODEX_CALLBACK_ADAPTER_REVISION,
+  hasEquivalentAgentReply,
+} from '../web/routes/provider-callbacks.js'
+
+beforeEach(() => {
+  dbGet.mockReset()
+})
+
+describe('Codex provider callback reply deduplication', () => {
+  it('advertises callback adapter revision 2', () => {
+    expect(CODEX_CALLBACK_ADAPTER_REVISION).toBe(2)
+  })
+
+  it('finds only an exact reply from the same agent and target inside the run window', () => {
+    dbGet.mockReturnValueOnce({ id: 17 })
+    expect(hasEquivalentAgentReply(
+      'codex-dedupe',
+      'bela',
+      'EXACT_FINAL_REPLY',
+      100,
+    )).toBe(true)
+    expect(dbGet).toHaveBeenCalledWith(
+      'codex-dedupe',
+      'bela',
+      'EXACT_FINAL_REPLY',
+      100,
+    )
+  })
+
+  it('returns false when the scoped query finds no equivalent reply', () => {
+    dbGet.mockReturnValueOnce(undefined)
+    expect(hasEquivalentAgentReply(
+      'codex-dedupe',
+      'bela',
+      'EXACT_FINAL_REPLY',
+      101,
+    )).toBe(false)
+  })
+})
