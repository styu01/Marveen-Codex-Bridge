+    expect(isCodexReasoningEffort('low')).toBe(false)
+    expect(isCodexReasoningEffort('max')).toBe(false)
+    expect(isCodexReasoningEffort('ultra')).toBe(false)
+    expect(isCodexReasoningEffort(undefined)).toBe(false)
+  })
+})
