+import { describe, expect, it } from 'vitest'
+import { isCodexReasoningEffort } from '../providers/types.js'
+
+describe('Codex reasoning effort contract', () => {
+  it('accepts only the Bridge-supported effort levels', () => {
+    expect(isCodexReasoningEffort('medium')).toBe(true)
+    expect(isCodexReasoningEffort('high')).toBe(true)
