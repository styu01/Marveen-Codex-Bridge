+const CODEX_IMAGE_TOKEN_RE = /\[codex-image:([0-9a-f]{8}-[0-9a-f-]{27,})\]\s*([^\n]*)/gi
+
+function buildBubbleContentHtml(content) {
+  const previews = []
+  const clean = String(content || '').replace(
+    CODEX_IMAGE_TOKEN_RE,
+    (_match, artifactId, label) => {
+      previews.push({ artifactId, label: String(label || '').trim() })
+      return label ? `🖼 ${label}` : '🖼 Codex kép'
+    },
+  )
+  const previewHtml = previews.map(item => `
+    <div class="codex-image-preview"
+         data-artifact-id="${escapeAttr(item.artifactId)}"
+         style="margin-top:10px;max-width:560px">
+      <div class="muted" style="font-size:11px;margin-bottom:5px">
+        ${escapeHtml(item.label || 'Codex által generált kép')}
+      </div>
+      <div class="codex-image-loading muted" style="font-size:11px">Kép betöltése…</div>
+    </div>
+  `).join('')
+  return `${escapeHtml(clean)}${previewHtml}`
+}
+
+async function hydrateCodexImages(root) {
+  const nodes = (root || document).querySelectorAll(
+    '.codex-image-preview[data-artifact-id]:not([data-loaded])',
+  )
+  for (const node of nodes) {
+    node.dataset.loaded = 'loading'
+    const artifactId = node.dataset.artifactId
+    try {
+      const response = await fetch(`/api/codex-artifacts/${encodeURIComponent(artifactId)}`)
+      if (!response.ok) throw new Error(`HTTP ${response.status}`)
+      const blob = await response.blob()
+      if (!blob.type.startsWith('image/')) throw new Error('invalid image response')
+      const objectUrl = URL.createObjectURL(blob)
+      const image = document.createElement('img')
+      image.src = objectUrl
+      image.alt = 'Codex által generált kép'
+      image.loading = 'lazy'
+      image.style.cssText = 'display:block;max-width:100%;max-height:520px;border-radius:10px;border:1px solid var(--border);object-fit:contain;background:var(--surface)'
+      const link = document.createElement('a')
+      link.href = objectUrl
+      link.download = `codex-image-${artifactId}.png`
+      link.textContent = 'Megnyitás / letöltés'
+      link.style.cssText = 'display:inline-block;margin-top:6px;font-size:11px'
+      node.querySelector('.codex-image-loading')?.remove()
+      node.append(image, link)
+      node.dataset.loaded = 'ready'
+    } catch {
+      const loading = node.querySelector('.codex-image-loading')
+      if (loading) loading.textContent = 'A képelőnézet nem tölthető be.'
+      node.dataset.loaded = 'error'
+    }
+  }
+}
