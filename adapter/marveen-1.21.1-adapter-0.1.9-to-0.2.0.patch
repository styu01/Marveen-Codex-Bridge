--- marveen-1.21.1-0.1.9/src/web/routes/codex-artifacts.ts	1970-01-01 09:00:00.000000000 +0900
+++ marveen-1.21.1-0.2.0/src/web/routes/codex-artifacts.ts	2026-07-29 01:01:20.591137766 +0900
@@ -0,0 +1,116 @@
+import { createHash } from 'node:crypto'
+import {
+  lstatSync,
+  readFileSync,
+  realpathSync,
+  statSync,
+} from 'node:fs'
+import { basename, isAbsolute, relative, sep } from 'node:path'
+import { codexBridgeClient } from '../../providers/codex-bridge-client.js'
+import { agentDir, readAgentProvider } from '../agent-config.js'
+import { json } from '../http-helpers.js'
+import type { RouteContext } from './types.js'
+
+const ARTIFACT_ID = /^[0-9a-f]{8}-[0-9a-f-]{27,}$/i
+const IMAGE_MIMES = new Set(['image/png', 'image/jpeg', 'image/webp'])
+const MAX_IMAGE_BYTES = 50 * 1024 * 1024
+
+interface BridgeImageArtifact {
+  artifactId: string
+  runId: string
+  agentId: string
+  kind: 'image'
+  status: 'ready'
+  mimeType: 'image/png' | 'image/jpeg' | 'image/webp'
+  fileName: string
+  absolutePath: string
+  workspaceRelativePath: string
+  sha256: string
+  byteSize: number
+}
+
+function within(root: string, candidate: string): boolean {
+  const rel = relative(root, candidate)
+  return rel === '' || (!rel.startsWith(`..${sep}`) && rel !== '..' && !isAbsolute(rel))
+}
+
+function safeFileName(value: string): string {
+  return basename(value).replace(/[^A-Za-z0-9._-]/g, '_').slice(0, 200) || 'codex-image'
+}
+
+export async function tryHandleCodexArtifacts(ctx: RouteContext): Promise<boolean> {
+  const { res, path, method } = ctx
+  const match = path.match(/^\/api\/codex-artifacts\/([^/]+)$/)
+  if (!match || method !== 'GET') return false
+
+  const artifactId = decodeURIComponent(match[1]!)
+  if (!ARTIFACT_ID.test(artifactId)) {
+    json(res, { error: 'Invalid Codex artifact id' }, 400)
+    return true
+  }
+
+  try {
+    const result = await codexBridgeClient.request<BridgeImageArtifact>(
+      'GET',
+      `/v1/artifacts/${encodeURIComponent(artifactId)}`,
+    )
+    const artifact = result.data
+    if (
+      artifact.artifactId !== artifactId
+      || artifact.kind !== 'image'
+      || artifact.status !== 'ready'
+      || !IMAGE_MIMES.has(artifact.mimeType)
+      || typeof artifact.agentId !== 'string'
+      || readAgentProvider(artifact.agentId) !== 'codex'
+      || typeof artifact.absolutePath !== 'string'
+      || typeof artifact.sha256 !== 'string'
+      || !/^[0-9a-f]{64}$/.test(artifact.sha256)
+      || !Number.isSafeInteger(artifact.byteSize)
+      || artifact.byteSize < 1
+      || artifact.byteSize > MAX_IMAGE_BYTES
+    ) {
+      json(res, { error: 'Invalid Codex artifact metadata' }, 502)
+      return true
+    }
+
+    const root = realpathSync(agentDir(artifact.agentId))
+    const canonical = realpathSync(artifact.absolutePath)
+    const lstat = lstatSync(artifact.absolutePath)
+    const stat = statSync(canonical)
+    if (
+      !within(root, canonical)
+      || lstat.isSymbolicLink()
+      || !stat.isFile()
+      || stat.size !== artifact.byteSize
+      || stat.size > MAX_IMAGE_BYTES
+    ) {
+      json(res, { error: 'Codex artifact file failed confinement validation' }, 409)
+      return true
+    }
+    const content = readFileSync(canonical)
+    const digest = createHash('sha256').update(content).digest('hex')
+    if (digest !== artifact.sha256) {
+      json(res, { error: 'Codex artifact integrity check failed' }, 409)
+      return true
+    }
+
+    const fileName = safeFileName(artifact.fileName)
+    res.writeHead(200, {
+      'Content-Type': artifact.mimeType,
+      'Content-Length': String(content.length),
+      'Content-Disposition': `inline; filename="${fileName}"`,
+      'Cache-Control': 'private, no-store',
+      'X-Content-Type-Options': 'nosniff',
+      'Content-Security-Policy': "default-src 'none'; sandbox",
+    })
+    res.end(content)
+  } catch (error) {
+    const status = Number((error as { status?: unknown }).status)
+    json(
+      res,
+      { error: status === 404 ? 'Codex artifact not found' : 'Codex artifact unavailable' },
+      status === 404 ? 404 : 503,
+    )
+  }
+  return true
+}
