+      || typeof item.agentId !== 'string'
+      || item.agentId !== run.agentId
+      || item.kind !== 'image'
+      || item.status !== 'ready'
+      || typeof item.mimeType !== 'string'
+      || !IMAGE_MIMES.has(item.mimeType)
+      || typeof item.fileName !== 'string'
+      || !item.fileName
+      || !relativePath
+      || relativePath.startsWith('/')
+      || relativePath.split(/[\\/]/).includes('..')
+    ) return []
+    return [{
+      artifactId: item.artifactId,
+      runId: item.runId,
+      agentId: item.agentId,
+      kind: 'image',
+      status: 'ready',
+      mimeType: item.mimeType as CallbackImageArtifact['mimeType'],
+      fileName: item.fileName.replace(/[\r\n]/g, ' ').slice(0, 255),
+      workspaceRelativePath: relativePath.replace(/[\r\n]/g, ' ').slice(0, 4096),
+    }]
+  })
+}
+
+export function buildCodexCallbackReply(run: CallbackRun): string {
+  const text = typeof run.finalResponse === 'string' ? run.finalResponse.trim() : ''
+  const images = safeImageArtifacts(run)
+  const imageLines = images.map(
+    (image) => `[codex-image:${image.artifactId}] ${image.fileName} — ${image.workspaceRelativePath}`,
+  )
+  return [text, ...imageLines].filter(Boolean).join('\n\n')
+}
 
