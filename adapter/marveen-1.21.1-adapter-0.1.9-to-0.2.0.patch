+function safeImageArtifacts(run: CallbackRun): CallbackImageArtifact[] {
+  if (!Array.isArray(run.artifacts)) return []
+  return run.artifacts.flatMap((value): CallbackImageArtifact[] => {
+    if (!value || typeof value !== 'object') return []
+    const item = value as Record<string, unknown>
+    const relativePath = typeof item.workspaceRelativePath === 'string'
