+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import {
+  agentDir,
+  readAgentCodexProviderConfig,
+} from '../web/agent-config.js'
+import { codexBridgeClient } from './codex-bridge-client.js'
+import type { ProviderDispatch, ProviderRun, ProviderStatus } from './types.js'
+
+const statusCache = new Map<string, ProviderStatus>()
+
+function readOptional(path: string): string {
+  try { return readFileSync(path, 'utf8') } catch { return '' }
+}
+
+function instructionsFor(agentId: string): string {
+  const dir = agentDir(agentId)
+  const identity = readOptional(join(dir, 'CLAUDE.md'))
+  const soul = readOptional(join(dir, 'SOUL.md'))
+  return [
+    'This agent is managed by Béla through the Codex Bridge.',
+    identity && `Béla agent identity:\n${identity}`,
+    soul && `Béla agent soul/personality:\n${soul}`,
+  ].filter(Boolean).join('\n\n')
+}
+
+export async function syncCodexAgent(agentId: string): Promise<void> {
+  const config = readAgentCodexProviderConfig(agentId)
+  await codexBridgeClient.request(
+    'PUT',
+    `/v1/agents/${encodeURIComponent(agentId)}`,
+    {
+      displayName: agentId,
+      model: config.model,
+      reasoningEffort: config.reasoningEffort,
+      workspacePath: agentDir(agentId),
+      workspaceMode: 'directory',
+      sandboxMode: config.sandboxMode,
+      approvalPolicy: config.approvalPolicy,
+      networkEnabled: config.networkEnabled,
+      instructions: instructionsFor(agentId),
+    },
+  )
+}
+
+export async function startCodexAgent(agentId: string): Promise<ProviderStatus> {
+  await syncCodexAgent(agentId)
+  const result = await codexBridgeClient.request<Record<string, unknown>>(
+    'POST',
+    `/v1/agents/${encodeURIComponent(agentId)}/start`,
+  )
+  const status: ProviderStatus = {
+    provider: 'codex',
+    reachable: true,
+    configured: true,
+    desiredState: String(result.data.desiredState ?? 'running'),
+    actualState: String(result.data.actualState ?? 'idle'),
+    model: String(result.data.model ?? readAgentCodexProviderConfig(agentId).model),
+    reasoningEffort: String(
+      result.data.reasoningEffort ?? readAgentCodexProviderConfig(agentId).reasoningEffort,
+    ) as ProviderStatus['reasoningEffort'],
+    imageGenerationAvailable: (
+      result.data.capabilities as Record<string, unknown> | undefined
+    )?.imageGeneration === true,
+    imageModel: String(
+      (result.data.capabilities as Record<string, unknown> | undefined)?.imageModel
+        ?? 'gpt-image-2',
+    ),
+  }
+  statusCache.set(agentId, status)
+  return status
+}
+
+export async function stopCodexAgent(agentId: string): Promise<ProviderStatus> {
+  const result = await codexBridgeClient.request<Record<string, unknown>>(
+    'POST',
+    `/v1/agents/${encodeURIComponent(agentId)}/stop`,
+  )
+  const status: ProviderStatus = {
+    provider: 'codex',
+    reachable: true,
+    configured: true,
+    desiredState: String(result.data.desiredState ?? 'stopped'),
+    actualState: String(result.data.actualState ?? 'offline'),
+    model: String(result.data.model ?? readAgentCodexProviderConfig(agentId).model),
+    reasoningEffort: String(
+      result.data.reasoningEffort ?? readAgentCodexProviderConfig(agentId).reasoningEffort,
+    ) as ProviderStatus['reasoningEffort'],
+    imageGenerationAvailable: (
+      result.data.capabilities as Record<string, unknown> | undefined
+    )?.imageGeneration === true,
+    imageModel: String(
+      (result.data.capabilities as Record<string, unknown> | undefined)?.imageModel
+        ?? 'gpt-image-2',
+    ),
+  }
+  statusCache.set(agentId, status)
+  return status
+}
+
+export async function restartCodexAgent(agentId: string, fresh = false): Promise<ProviderStatus> {
+  await syncCodexAgent(agentId)
+  if (fresh) {
+    await codexBridgeClient.request(
+      'POST',
+      `/v1/agents/${encodeURIComponent(agentId)}/fresh-thread`,
+    )
+  }
+  const result = await codexBridgeClient.request<Record<string, unknown>>(
+    'POST',
+    `/v1/agents/${encodeURIComponent(agentId)}/restart`,
+  )
+  const status: ProviderStatus = {
+    provider: 'codex',
+    reachable: true,
+    configured: true,
+    desiredState: String(result.data.desiredState ?? 'running'),
+    actualState: String(result.data.actualState ?? 'idle'),
+    model: String(result.data.model ?? readAgentCodexProviderConfig(agentId).model),
+    reasoningEffort: String(
+      result.data.reasoningEffort ?? readAgentCodexProviderConfig(agentId).reasoningEffort,
+    ) as ProviderStatus['reasoningEffort'],
+    imageGenerationAvailable: (
+      result.data.capabilities as Record<string, unknown> | undefined
+    )?.imageGeneration === true,
+    imageModel: String(
+      (result.data.capabilities as Record<string, unknown> | undefined)?.imageModel
+        ?? 'gpt-image-2',
+    ),
+  }
+  statusCache.set(agentId, status)
+  return status
+}
+
+export async function getCodexAgentStatus(agentId: string): Promise<ProviderStatus> {
+  try {
+    const result = await codexBridgeClient.request<{
+      desiredState?: string
+      actualState?: string
+      model?: string
+      reasoningEffort?: ProviderStatus['reasoningEffort']
+      capabilities?: {
+        imageGeneration?: boolean
+        imageModel?: string | null
+      }
+    }>('GET', `/v1/agents/${encodeURIComponent(agentId)}`)
+    const status: ProviderStatus = {
+      provider: 'codex',
+      reachable: true,
+      configured: true,
+      desiredState: result.data.desiredState,
+      actualState: result.data.actualState,
+      model: result.data.model,
+      reasoningEffort: result.data.reasoningEffort,
+      imageGenerationAvailable: result.data.capabilities?.imageGeneration === true,
+      imageModel: result.data.capabilities?.imageModel ?? null,
+    }
+    statusCache.set(agentId, status)
+    return status
+  } catch (error) {
+    const err = error as Error & { status?: number }
+    const status: ProviderStatus = {
+      provider: 'codex',
+      reachable: err.status === 404,
+      configured: false,
+      error: err.message,
+    }
+    statusCache.set(agentId, status)
+    return status
+  }
+}
+
+export function getCachedCodexAgentStatus(agentId: string): ProviderStatus | null {
+  return statusCache.get(agentId) ?? null
+}
+
+export async function dispatchCodexRun(
+  agentId: string,
+  dispatch: ProviderDispatch,
+): Promise<ProviderRun> {
+  const result = await codexBridgeClient.request<{
+    runId: string
+    state: string
+  }>(
+    'POST',
+    `/v1/agents/${encodeURIComponent(agentId)}/runs`,
+    {
+      prompt: dispatch.prompt,
+      context: dispatch.context,
+      priority: 0,
+    },
+    { 'idempotency-key': `bela-message-${dispatch.messageId}` },
+  )
+  return {
+    runId: result.data.runId,
+    state: result.data.state,
+    duplicate: result.duplicate,
+  }
+}
