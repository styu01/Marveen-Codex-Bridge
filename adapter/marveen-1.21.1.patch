+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const dbGet = vi.hoisted(() => vi.fn())
+
+vi.mock('../db.js', () => ({
+  createAgentMessage: vi.fn(),
+  getAgentMessage: vi.fn(),
+  getDb: () => ({
+    prepare: vi.fn(() => ({ get: dbGet })),
+  }),
+  markMessageDone: vi.fn(),
+  markMessageFailed: vi.fn(),
+}))
+
+import {
+  CODEX_CALLBACK_ADAPTER_REVISION,
+  buildCodexCallbackReply,
+  hasEquivalentAgentReply,
+} from '../web/routes/provider-callbacks.js'
+
+beforeEach(() => {
+  dbGet.mockReset()
+})
+
+describe('Codex provider callback reply deduplication', () => {
+  it('advertises callback adapter revision 3', () => {
+    expect(CODEX_CALLBACK_ADAPTER_REVISION).toBe(3)
+  })
+
+  it('finds only an exact reply from the same agent and target inside the run window', () => {
+    dbGet.mockReturnValueOnce({ id: 17 })
+    expect(hasEquivalentAgentReply(
+      'codex-dedupe',
+      'bela',
+      'EXACT_FINAL_REPLY',
+      100,
+    )).toBe(true)
+    expect(dbGet).toHaveBeenCalledWith(
+      'codex-dedupe',
+      'bela',
+      'EXACT_FINAL_REPLY',
+      100,
+    )
+  })
+
+  it('returns false when the scoped query finds no equivalent reply', () => {
+    dbGet.mockReturnValueOnce(undefined)
+    expect(hasEquivalentAgentReply(
+      'codex-dedupe',
+      'bela',
+      'EXACT_FINAL_REPLY',
+      101,
+    )).toBe(false)
+  })
+
+  it('adds only run-scoped verified image artifact tokens to the reply', () => {
+    const runId = 'run-image-1'
+    const agentId = 'codex-image'
+    const reply = buildCodexCallbackReply({
+      runId,
+      agentId,
+      finalResponse: 'A kép elkészült.',
+      artifacts: [
+        {
+          artifactId: '76b94870-dcdd-4b21-8ea6-d6ad52e619ef',
+          runId,
+          agentId,
+          kind: 'image',
+          status: 'ready',
+          mimeType: 'image/png',
+          fileName: 'hero.png',
+          workspaceRelativePath: 'assets/hero.png',
+        },
+        {
+          artifactId: '9d91d323-7c40-41fd-a5e5-8d12e9127b5d',
+          runId: 'other-run',
+          agentId,
+          kind: 'image',
+          status: 'ready',
+          mimeType: 'image/png',
+          fileName: 'spoof.png',
+          workspaceRelativePath: '../../spoof.png',
+        },
+      ],
+    })
+    expect(reply).toContain('A kép elkészült.')
+    expect(reply).toContain(
+      '[codex-image:76b94870-dcdd-4b21-8ea6-d6ad52e619ef] hero.png — assets/hero.png',
+    )
+    expect(reply).not.toContain('spoof.png')
+  })
+})
