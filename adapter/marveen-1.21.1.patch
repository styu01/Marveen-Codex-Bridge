+vi.mock('../providers/codex-provider.js', () => ({
+  dispatchCodexRun: (...args: unknown[]) => mockDispatch(...args),
+}))
+vi.mock('../providers/codex-bridge-client.js', () => ({
+  CodexBridgeHttpError: class CodexBridgeHttpError extends Error {},
+}))
+
+import { runMessageRouterTick } from '../web/message-router.js'
+
+describe('Codex message routing', () => {
