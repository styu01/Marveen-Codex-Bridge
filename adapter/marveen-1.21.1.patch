--- marveen-1.21.1-current/src/web/routes/codex-approvals.ts	1970-01-01 09:00:00.000000000 +0900
+++ marveen-1.21.1-0.2.0/src/web/routes/codex-approvals.ts	2026-07-28 15:40:20.306548195 +0900
@@ -0,0 +1,63 @@
+import { codexBridgeClient } from '../../providers/codex-bridge-client.js'
+import { json, readBody } from '../http-helpers.js'
+import type { RouteContext } from './types.js'
+
+interface BridgeApproval {
+  approvalId: string
+  agentId: string
+  category: string
+  request: Record<string, unknown>
+  state: string
+  expiresAt: string
+  createdAt: string
+}
+
+export async function tryHandleCodexApprovals(ctx: RouteContext): Promise<boolean> {
+  const { req, res, path, method } = ctx
+
+  if (path === '/api/codex-approvals' && method === 'GET') {
+    try {
+      const result = await codexBridgeClient.request<BridgeApproval[]>('GET', '/v1/approvals')
+      json(res, result.data.map(approval => ({
+        id: approval.approvalId,
+        agentId: approval.agentId,
+        category: approval.category,
+        request: approval.request,
+        state: approval.state,
+        expiresAt: approval.expiresAt,
+        createdAt: approval.createdAt,
+      })))
+    } catch (err) {
+      json(res, { error: err instanceof Error ? err.message : 'Codex approvals unavailable' }, 502)
+    }
+    return true
+  }
+
+  const match = path.match(/^\/api\/codex-approvals\/([^/]+)$/)
+  if (match && method === 'PATCH') {
+    let body: { decision?: unknown }
+    try {
+      body = JSON.parse((await readBody(req, { maxBytes: 16 * 1024 })).toString())
+    } catch {
+      json(res, { error: 'Invalid JSON' }, 400)
+      return true
+    }
+    if (body.decision !== 'approve' && body.decision !== 'decline') {
+      json(res, { error: 'decision must be approve or decline' }, 400)
+      return true
+    }
+    try {
+      const result = await codexBridgeClient.request<Record<string, unknown>>(
+        'POST',
+        `/v1/approvals/${encodeURIComponent(match[1]!)}/decision`,
+        { decision: body.decision },
+      )
+      json(res, result.data)
+    } catch (err) {
+      json(res, { error: err instanceof Error ? err.message : 'Codex approval decision failed' }, 502)
+    }
+    return true
+  }
+
+  return false
+}
