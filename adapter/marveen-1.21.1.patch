+      : {}
+    const sandbox = typeof raw.sandboxMode === 'string'
+      && CODEX_SANDBOXES.has(raw.sandboxMode as CodexProviderConfig['sandboxMode'])
+      ? raw.sandboxMode as CodexProviderConfig['sandboxMode']
+      : 'workspace-write'
+    const approval = typeof raw.approvalPolicy === 'string'
+      && CODEX_APPROVALS.has(raw.approvalPolicy as CodexProviderConfig['approvalPolicy'])
+      ? raw.approvalPolicy as CodexProviderConfig['approvalPolicy']
+      : 'bela'
