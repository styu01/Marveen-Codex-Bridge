+++ marveen-1.21.1-0.2.0/src/web/routes/provider-callbacks.ts	2026-07-29 01:02:47.379135884 +0900
@@ -0,0 +1,222 @@
+import { timingSafeEqual } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { MAIN_AGENT_ID } from '../../config.js'
+import {
+  createAgentMessage,
+  getAgentMessage,
+  getDb,
+  markMessageDone,
+  markMessageFailed,
+} from '../../db.js'
+import { logger } from '../../logger.js'
+import { readAgentProvider } from '../agent-config.js'
+import { json, readBody } from '../http-helpers.js'
+import type { RouteContext } from './types.js'
+
+const TOKEN_FILE = process.env.BELA_CODEX_BRIDGE_TOKEN_FILE
+  || join(homedir(), '.config', 'bela-codex-bridge', 'token')
+
+function bridgeAuthorized(header: string | undefined): boolean {
+  const match = /^Bearer\s+(.+)$/.exec(header ?? '')
+  if (!match) return false
+  let expected: string
+  try { expected = readFileSync(TOKEN_FILE, 'utf8').trim() } catch { return false }
+  const actualBuffer = Buffer.from(match[1]!.trim())
+  const expectedBuffer = Buffer.from(expected)
+  return expectedBuffer.length >= 32
+    && actualBuffer.length === expectedBuffer.length
+    && timingSafeEqual(actualBuffer, expectedBuffer)
+}
+
+interface CallbackRun {
+  runId?: unknown
+  agentId?: unknown
+  state?: unknown
+  startedAt?: unknown
+  finalResponse?: unknown
+  errorCode?: unknown
+  errorMessage?: unknown
+  context?: unknown
+  artifacts?: unknown
+}
+
+interface CallbackImageArtifact {
+  artifactId: string
+  runId: string
+  agentId: string
+  kind: 'image'
+  status: 'ready'
+  mimeType: 'image/png' | 'image/jpeg' | 'image/webp'
+  fileName: string
+  workspaceRelativePath: string
+}
+
+const ARTIFACT_ID = /^[0-9a-f]{8}-[0-9a-f-]{27,}$/i
+const IMAGE_MIMES = new Set(['image/png', 'image/jpeg', 'image/webp'])
+
+export const CODEX_CALLBACK_ADAPTER_REVISION = 3
+
+function safeImageArtifacts(run: CallbackRun): CallbackImageArtifact[] {
+  if (!Array.isArray(run.artifacts)) return []
+  return run.artifacts.flatMap((value): CallbackImageArtifact[] => {
+    if (!value || typeof value !== 'object') return []
+    const item = value as Record<string, unknown>
+    const relativePath = typeof item.workspaceRelativePath === 'string'
+      ? item.workspaceRelativePath
+      : ''
+    if (
+      typeof item.artifactId !== 'string'
+      || !ARTIFACT_ID.test(item.artifactId)
+      || typeof item.runId !== 'string'
+      || item.runId !== run.runId
+      || typeof item.agentId !== 'string'
+      || item.agentId !== run.agentId
+      || item.kind !== 'image'
+      || item.status !== 'ready'
+      || typeof item.mimeType !== 'string'
+      || !IMAGE_MIMES.has(item.mimeType)
+      || typeof item.fileName !== 'string'
+      || !item.fileName
+      || !relativePath
+      || relativePath.startsWith('/')
+      || relativePath.split(/[\\/]/).includes('..')
+    ) return []
+    return [{
+      artifactId: item.artifactId,
+      runId: item.runId,
+      agentId: item.agentId,
+      kind: 'image',
+      status: 'ready',
+      mimeType: item.mimeType as CallbackImageArtifact['mimeType'],
+      fileName: item.fileName.replace(/[\r\n]/g, ' ').slice(0, 255),
+      workspaceRelativePath: relativePath.replace(/[\r\n]/g, ' ').slice(0, 4096),
+    }]
+  })
+}
+
+export function buildCodexCallbackReply(run: CallbackRun): string {
+  const text = typeof run.finalResponse === 'string' ? run.finalResponse.trim() : ''
+  const images = safeImageArtifacts(run)
+  const imageLines = images.map(
+    (image) => `[codex-image:${image.artifactId}] ${image.fileName} — ${image.workspaceRelativePath}`,
+  )
+  return [text, ...imageLines].filter(Boolean).join('\n\n')
+}
+
+export function hasEquivalentAgentReply(
+  fromAgent: string,
+  toAgent: string,
+  content: string,
+  notBefore: number,
+): boolean {
+  const row = getDb().prepare(`
+    SELECT id
+    FROM agent_messages
+    WHERE from_agent = ?
+      AND to_agent = ?
+      AND content = ?
+      AND created_at >= ?
+    ORDER BY id DESC
+    LIMIT 1
+  `).get(fromAgent, toAgent, content, notBefore)
+  return Boolean(row)
+}
+
+export async function tryHandleProviderCallbacks(ctx: RouteContext): Promise<boolean> {
+  const { req, res, path, method } = ctx
+  if (path !== '/api/provider-callbacks/codex' || method !== 'POST') return false
+
+  if (!bridgeAuthorized(req.headers.authorization)) {
+    json(res, { error: 'Unauthorized Bridge callback' }, 401)
+    return true
+  }
+
+  let payload: { schemaVersion?: unknown; run?: CallbackRun }
+  try {
+    payload = JSON.parse((await readBody(req, { maxBytes: 2 * 1024 * 1024 })).toString())
+  } catch {
+    json(res, { error: 'Invalid callback JSON' }, 400)
+    return true
+  }
+  const run = payload.run
+  const context = run?.context && typeof run.context === 'object'
+    ? run.context as Record<string, unknown>
+    : {}
+  const messageId = Number(context.belaMessageId)
+  if (
+    payload.schemaVersion !== 1
+    || !run
+    || typeof run.runId !== 'string'
+    || typeof run.agentId !== 'string'
+    || typeof run.state !== 'string'
+    || !Number.isSafeInteger(messageId)
+    || messageId <= 0
+  ) {
+    json(res, { error: 'Invalid callback schema' }, 400)
+    return true
+  }
+
+  const db = getDb()
+  const result = db.transaction(() => {
+    const original = getAgentMessage(messageId)
+    if (!original) return { status: 404, body: { error: 'Original Béla message not found' } }
+    if (original.to_agent !== run.agentId || readAgentProvider(run.agentId) !== 'codex') {
+      return { status: 409, body: { error: 'Callback agent/message mismatch' } }
+    }
+    if (original.status === 'done' || original.status === 'failed') {
+      return { status: 200, body: { ok: true, duplicate: true } }
+    }
+
+    if (run.state === 'succeeded') {
+      const reply = buildCodexCallbackReply(run)
+      const target = original.from_agent === 'system' ? MAIN_AGENT_ID : original.from_agent
+      const startedAt = typeof run.startedAt === 'string'
+        ? Math.floor(Date.parse(run.startedAt) / 1000)
+        : Number.NaN
+      const notBefore = Number.isSafeInteger(startedAt)
+        ? startedAt
+        : (original.delivered_at ?? original.created_at)
+      const duplicateReply = Boolean(reply) && hasEquivalentAgentReply(
+        run.agentId,
+        target,
+        reply,
+        notBefore,
+      )
+      if (reply && !duplicateReply) {
+        createAgentMessage(run.agentId, target, reply)
+      }
+      markMessageDone(messageId, `Codex run ${run.runId} completed`)
+      return {
+        status: 200,
+        body: {
+          ok: true,
+          replyQueued: Boolean(reply) && !duplicateReply,
+          replyDuplicate: duplicateReply,
+        },
+      }
+    }
+
+    const reason = [
+      typeof run.errorCode === 'string' ? run.errorCode : 'codex_run_failed',
+      typeof run.errorMessage === 'string' ? run.errorMessage : `state=${run.state}`,
+    ].join(': ')
+    markMessageFailed(messageId, reason.slice(0, 2000))
+    createAgentMessage(
+      'system',
+      MAIN_AGENT_ID,
+      `[codex-bridge-failure] ${run.agentId} nem tudta feldolgozni a(z) #${messageId} üzenetet: ${reason.slice(0, 500)}`,
+    )
+    return { status: 200, body: { ok: true, failed: true } }
+  })()
+
+  logger.info({
+    runId: run.runId,
+    agentId: run.agentId,
+    messageId,
+    state: run.state,
+  }, 'Codex Bridge callback processed')
+  json(res, result.body, result.status)
+  return true
+}
