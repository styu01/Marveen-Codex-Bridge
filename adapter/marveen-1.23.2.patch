diff -ruN a/src/providers/codex-bridge-client.ts b/src/providers/codex-bridge-client.ts
--- a/src/providers/codex-bridge-client.ts	1970-01-01 01:00:00.000000000 +0100
+++ b/src/providers/codex-bridge-client.ts	2026-07-27 17:43:08.073174171 +0100
@@ -0,0 +1,123 @@
+import { readFileSync } from 'node:fs'
+import http from 'node:http'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+
+const DEFAULT_SOCKET = process.env.BELA_CODEX_BRIDGE_SOCKET
+  || `/run/user/${process.getuid?.() ?? 1000}/bela-codex-bridge.sock`
+const DEFAULT_TOKEN_FILE = process.env.BELA_CODEX_BRIDGE_TOKEN_FILE
+  || join(homedir(), '.config', 'bela-codex-bridge', 'token')
+
+export class CodexBridgeHttpError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+    readonly retryable: boolean,
+  ) {
+    super(message)
+    this.name = 'CodexBridgeHttpError'
+  }
+}
+
+interface BridgeEnvelope<T> {
+  data?: T
+  duplicate?: boolean
+  error?: { code?: string; message?: string }
+}
+
+export class CodexBridgeClient {
+  constructor(
+    private readonly socketPath = DEFAULT_SOCKET,
+    private readonly tokenFile = DEFAULT_TOKEN_FILE,
+    private readonly timeoutMs = 30_000,
+  ) {}
+
+  async request<T>(
+    method: string,
+    path: string,
+    body?: Record<string, unknown>,
+    extraHeaders: Record<string, string> = {},
+  ): Promise<{ data: T; duplicate: boolean }> {
+    let token: string
+    try {
+      token = readFileSync(this.tokenFile, 'utf8').trim()
+    } catch (error) {
+      throw new CodexBridgeHttpError(
+        503,
+        'bridge_token_unavailable',
+        `Codex Bridge token cannot be read: ${(error as Error).message}`,
+        true,
+      )
+    }
+    if (!token) {
+      throw new CodexBridgeHttpError(503, 'bridge_token_empty', 'Codex Bridge token file is empty', true)
+    }
+
+    const payload = body === undefined ? null : Buffer.from(JSON.stringify(body))
+    return new Promise((resolve, reject) => {
+      const req = http.request({
+        socketPath: this.socketPath,
+        path,
+        method,
+        headers: {
+          authorization: `Bearer ${token}`,
+          accept: 'application/json',
+          ...(payload
+            ? {
+                'content-type': 'application/json',
+                'content-length': String(payload.length),
+              }
+            : {}),
+          ...extraHeaders,
+        },
+      }, (res) => {
+        const chunks: Buffer[] = []
+        let bytes = 0
+        res.on('data', (chunk: Buffer) => {
+          bytes += chunk.length
+          if (bytes > 4 * 1024 * 1024) {
+            req.destroy(new Error('Codex Bridge response exceeds 4 MiB'))
+            return
+          }
+          chunks.push(chunk)
+        })
+        res.on('end', () => {
+          let parsed: BridgeEnvelope<T>
+          try {
+            parsed = JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}') as BridgeEnvelope<T>
+          } catch {
+            reject(new CodexBridgeHttpError(
+              res.statusCode ?? 502,
+              'invalid_bridge_response',
+              'Codex Bridge returned invalid JSON',
+              true,
+            ))
+            return
+          }
+          const status = res.statusCode ?? 502
+          if (status < 200 || status >= 300 || parsed.data === undefined) {
+            const code = parsed.error?.code || `http_${status}`
+            reject(new CodexBridgeHttpError(
+              status,
+              code,
+              parsed.error?.message || `Codex Bridge HTTP ${status}`,
+              status >= 500 || status === 408 || status === 409 || status === 429,
+            ))
+            return
+          }
+          resolve({ data: parsed.data, duplicate: parsed.duplicate === true })
+        })
+      })
+      req.setTimeout(this.timeoutMs, () => req.destroy(new Error('Codex Bridge request timed out')))
+      req.on('error', (error) => {
+        if (error instanceof CodexBridgeHttpError) reject(error)
+        else reject(new CodexBridgeHttpError(503, 'bridge_unreachable', error.message, true))
+      })
+      if (payload) req.end(payload)
+      else req.end()
+    })
+  }
+}
+
+export const codexBridgeClient = new CodexBridgeClient()
