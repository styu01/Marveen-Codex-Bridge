+// Provider selection is stored next to the existing per-agent model config so
+// a Béla update cannot split identity and runtime choice across two stores.
+// Missing/invalid values deliberately fall back to Claude for backwards
+// compatibility with every agent created before the Bridge existed.
+export function readAgentProvider(name: string): AgentProvider {
+  const configPath = join(agentDir(name), 'agent-config.json')
+  try {
+    const config = JSON.parse(readFileOr(configPath, '{}')) as Record<string, unknown>
+    return config.provider === 'codex' ? 'codex' : 'claude'
+  } catch {
+    return 'claude'
+  }
+}
+
+export function writeAgentProvider(name: string, provider: AgentProvider): void {
+  const configPath = join(agentDir(name), 'agent-config.json')
+  let config: Record<string, unknown> = {}
+  try { config = JSON.parse(readFileOr(configPath, '{}')) } catch {}
+  config.provider = provider
+  atomicWriteFileSync(configPath, JSON.stringify(config, null, 2))
+}
+
+const CODEX_SANDBOXES = new Set<CodexProviderConfig['sandboxMode']>([
+  'read-only',
+  'workspace-write',
+  'danger-full-access',
+])
+const CODEX_APPROVALS = new Set<CodexProviderConfig['approvalPolicy']>(['never', 'bela'])
+
+export function readAgentCodexProviderConfig(name: string): CodexProviderConfig {
+  const configPath = join(agentDir(name), 'agent-config.json')
+  try {
+    const config = JSON.parse(readFileOr(configPath, '{}')) as Record<string, unknown>
+    const raw = config.providerConfig && typeof config.providerConfig === 'object'
+      ? config.providerConfig as Record<string, unknown>
+      : {}
+    const sandbox = typeof raw.sandboxMode === 'string'
+      && CODEX_SANDBOXES.has(raw.sandboxMode as CodexProviderConfig['sandboxMode'])
+      ? raw.sandboxMode as CodexProviderConfig['sandboxMode']
+      : 'workspace-write'
+    const approval = typeof raw.approvalPolicy === 'string'
+      && CODEX_APPROVALS.has(raw.approvalPolicy as CodexProviderConfig['approvalPolicy'])
+      ? raw.approvalPolicy as CodexProviderConfig['approvalPolicy']
+      : 'bela'
+    return {
+      model: typeof raw.model === 'string' && raw.model.trim()
+        ? raw.model.trim()
+        : 'gpt-5.6-terra',
+      sandboxMode: sandbox,
+      approvalPolicy: approval,
+      networkEnabled: raw.networkEnabled === true,
+    }
+  } catch {
+    return {
+      model: 'gpt-5.6-terra',
+      sandboxMode: 'workspace-write',
+      approvalPolicy: 'bela',
+      networkEnabled: false,
+    }
+  }
+}
+
+export function writeAgentCodexProviderConfig(
+  name: string,
+  value: Partial<CodexProviderConfig>,
+): void {
+  const configPath = join(agentDir(name), 'agent-config.json')
+  let config: Record<string, unknown> = {}
+  try { config = JSON.parse(readFileOr(configPath, '{}')) } catch {}
+  const current = readAgentCodexProviderConfig(name)
+  const next: CodexProviderConfig = {
+    model: typeof value.model === 'string' && value.model.trim() ? value.model.trim() : current.model,
+    sandboxMode: value.sandboxMode && CODEX_SANDBOXES.has(value.sandboxMode)
+      ? value.sandboxMode
+      : current.sandboxMode,
+    approvalPolicy: value.approvalPolicy && CODEX_APPROVALS.has(value.approvalPolicy)
+      ? value.approvalPolicy
+      : current.approvalPolicy,
+    networkEnabled: value.networkEnabled ?? current.networkEnabled,
+  }
+  config.providerConfig = next
+  atomicWriteFileSync(configPath, JSON.stringify(config, null, 2))
+}
