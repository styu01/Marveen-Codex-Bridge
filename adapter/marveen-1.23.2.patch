+} from '../../db.js'
+import { isQualifiedId } from '../federation/address.js'
+import { isKnownAgent, readAgentProvider } from '../agent-config.js'
+import { json, readBody } from '../http-helpers.js'
+import type { RouteContext } from './types.js'
+
+const TOKEN_FILE = process.env.BELA_CODEX_BRIDGE_TOKEN_FILE
+  || join(homedir(), '.config', 'bela-codex-bridge', 'token')
+const AGENT_ID = /^[a-z][a-z0-9-]{1,62}$/
+
+function authenticate(header: string | undefined): { agentId: string; scopedToken: string } | null {
+  const match = /^Bearer\s+(bcm1\.([a-z][a-z0-9-]{1,62})\.([A-Za-z0-9_-]+))$/.exec(header ?? '')
+  if (!match) return null
+  let master: string
+  try { master = readFileSync(TOKEN_FILE, 'utf8').trim() } catch { return null }
+  if (master.length < 32) return null
+  const expected = createHmac('sha256', master)
+    .update(`bela-codex-mcp:v1:${match[2]}`)
+    .digest('base64url')
+  const actualBuffer = Buffer.from(match[3]!)
+  const expectedBuffer = Buffer.from(expected)
+  if (actualBuffer.length !== expectedBuffer.length || !timingSafeEqual(actualBuffer, expectedBuffer)) return null
+  const agentId = match[2]!
+  if (!AGENT_ID.test(agentId) || !isKnownAgent(agentId) || readAgentProvider(agentId) !== 'codex') return null
+  return { agentId, scopedToken: match[1]! }
+}
+
+function memoryOpaqueId(scopedToken: string, id: number): string {
+  const mac = createHmac('sha256', scopedToken).update(`memory:v1:${id}`).digest('base64url').slice(0, 24)
+  return `${id}.${mac}`
+}
+
+function memoryView(memory: Memory, scopedToken: string): Record<string, unknown> {
+  return {
+    id: memoryOpaqueId(scopedToken, memory.id),
+    content: memory.content.slice(0, 20_000),
+    sector: memory.sector,
+    category: memory.category,
+    agentId: memory.agent_id,
+    keywords: memory.keywords,
+    createdAt: memory.created_at,
+    accessedAt: memory.accessed_at,
+  }
+}
+
+function resolveMemory(
+  opaque: string,
+  agentId: string,
+  scopedToken: string,
+): Memory | null {
+  const match = /^([1-9]\d*)\.([A-Za-z0-9_-]{24})$/.exec(opaque)
+  if (!match) return null
+  const id = Number(match[1])
+  const expected = memoryOpaqueId(scopedToken, id)
+  const actualBuffer = Buffer.from(opaque)
+  const expectedBuffer = Buffer.from(expected)
+  if (actualBuffer.length !== expectedBuffer.length || !timingSafeEqual(actualBuffer, expectedBuffer)) return null
+  return getDb().prepare(
+    "SELECT * FROM memories WHERE id = ? AND (agent_id = ? OR category = 'shared')",
+  ).get(id, agentId) as Memory | undefined ?? null
+}
+
+export async function tryHandleCodexFacade(ctx: RouteContext): Promise<boolean> {
+  const { req, res, path, method } = ctx
+  if (!path.startsWith('/api/codex-facade/')) return false
+
+  const identity = authenticate(req.headers.authorization)
+  if (!identity) {
+    json(res, { error: 'Unauthorized Codex facade token' }, 401)
+    return true
+  }
+
+  if (path === '/api/codex-facade/messages' && method === 'POST') {
+    let body: Record<string, unknown>
+    try {
+      body = JSON.parse((await readBody(req, { maxBytes: 300 * 1024 })).toString())
+    } catch {
+      json(res, { error: 'Invalid JSON' }, 400)
+      return true
+    }
+    const rawTo = typeof body.to === 'string' ? body.to.trim() : ''
+    const to = rawTo === 'bela' ? MAIN_AGENT_ID : rawTo
+    const content = typeof body.content === 'string' ? body.content.trim() : ''
+    const validTarget = to === MAIN_AGENT_ID || isKnownAgent(to) || isQualifiedId(to)
+    if (!validTarget || !content || Buffer.byteLength(content) > 256 * 1024) {
+      json(res, { error: 'Invalid target or content' }, 400)
+      return true
+    }
+    const ref = typeof body.ref === 'string' ? body.ref.slice(0, 200) : null
+    const message = createAgentMessage(identity.agentId, to, content, ref)
+    json(res, { ok: true, message: { id: message.id, status: message.status, to: message.to_agent } }, 201)
+    return true
+  }
+
+  const messageMatch = path.match(/^\/api\/codex-facade\/messages\/([1-9]\d*)$/)
+  if (messageMatch && method === 'GET') {
+    const message = getAgentMessage(Number(messageMatch[1]))
+    if (!message || message.from_agent !== identity.agentId) {
+      json(res, { error: 'Message not found' }, 404)
+      return true
+    }
+    json(res, {
+      ok: true,
+      message: {
+        id: message.id,
+        to: message.to_agent,
+        status: message.status,
+        result: message.result,
+        createdAt: message.created_at,
+        completedAt: message.completed_at,
+      },
+    })
+    return true
+  }
+
+  if (path === '/api/codex-facade/memories/search' && method === 'POST') {
+    let body: Record<string, unknown>
+    try {
+      body = JSON.parse((await readBody(req, { maxBytes: 16 * 1024 })).toString())
+    } catch {
+      json(res, { error: 'Invalid JSON' }, 400)
+      return true
+    }
+    const query = typeof body.query === 'string' ? body.query.trim().slice(0, 1000) : ''
+    const limit = Number.isInteger(body.limit) ? Math.min(20, Math.max(1, Number(body.limit))) : 10
+    if (!query) {
+      json(res, { error: 'query is required' }, 400)
+      return true
+    }
+    const memories = searchAgentMemories(identity.agentId, query, limit)
+    touchMemoriesAccessed(memories.map((memory) => memory.id))
+    json(res, {
+      ok: true,
+      memories: memories.map((memory) => memoryView(memory, identity.scopedToken)),
+    })
+    return true
+  }
+
+  const memoryMatch = path.match(/^\/api\/codex-facade\/memories\/([^/]+)$/)
+  if (memoryMatch && method === 'GET') {
+    const memory = resolveMemory(decodeURIComponent(memoryMatch[1]!), identity.agentId, identity.scopedToken)
+    if (!memory) {
+      json(res, { error: 'Memory not found' }, 404)
+      return true
+    }
+    touchMemoriesAccessed([memory.id])
+    json(res, { ok: true, memory: memoryView(memory, identity.scopedToken) })
+    return true
+  }
+
+  json(res, { error: 'Codex facade route not found' }, 404)
+  return true
+}
