{
  "name": "bela-codex-bridge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:unit": "npm run build && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js",
    "doctor": "node dist/src/cli/doctor.js",
    "probe": "node dist/src/cli/probe.js"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
